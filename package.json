{
  "name": "anhui-zsb-navigation",
  "private": true,
  "version": "1.0.0",
  "description": "安徽普通专升本院校、专业、培养地点与考试方案导航站",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaiwen00910-star/c-u-study.git"
  },
  "homepage": "https://ahzsb.work/",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "validate:data": "node scripts/validate-content.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "audit:links": "node scripts/audit-links.mjs",
    "snapshot:export": "node scripts/export-public-snapshot.mjs",
    "build:with-snapshot": "npm run snapshot:export && npm run build",
    "build": "npm run validate:data && npm run generate:sitemap && vite build",
    "lint": "oxlint",
    "test": "vitest run --pool=threads --maxWorkers=1",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "papaparse": "^5.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.75.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
